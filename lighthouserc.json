{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3442",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3442/",
        "http://localhost:3442/?example",
        "http://localhost:3442/teardown"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.6
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports"
    }
  }
}